@startuml
skinparam componentStyle rectangle

package "Flutter App" {
  [main.dart] as Main
  [AppRoot] as AppRoot
  [GoRouter] as Router
  [AppTheme] as Theme
}

package "Core" {
  [Models] as Models
  [AuthProvider] as AuthProvider
  [AppModeProvider] as AppModeProvider
  [NotificationProvider] as NotificationProvider
}

package "Passenger Feature" {
  [PassengerHomePage] as PassengerPage
  [PassengerBookingProvider] as PassengerProvider
  [MockPassengerRepository] as PassengerRepo
}

package "Driver Feature" {
  [DriverHomePage] as DriverPage
  [DriverTaskProvider] as DriverProvider
  [MockDriverRepository] as DriverRepo
}

package "Admin Feature" {
  [AdminHomePage] as AdminPage
  [AdminProvider] as AdminProvider
  [MockAdminRepository] as AdminRepo
}

Main --> AppRoot
AppRoot --> Router
AppRoot --> Theme
Router --> AuthProvider
Router --> AppModeProvider
Router --> PassengerPage
Router --> DriverPage
Router --> AdminPage

PassengerPage --> PassengerProvider
PassengerProvider --> PassengerRepo
PassengerProvider --> Models
PassengerProvider --> NotificationProvider
PassengerProvider --> AuthProvider

DriverPage --> DriverProvider
DriverProvider --> DriverRepo
DriverProvider --> Models

AdminPage --> AdminProvider
AdminProvider --> AdminRepo
AdminProvider --> Models
@enduml
