@startuml
start
:管理员查看预约需求汇总;
if (选择调度方式) then (AI 辅助)
  :读取空闲车辆和已绑定司机;
  :按预约人数降序排列需求;
  repeat
    :为需求匹配座位数足够的车辆;
    if (找到候选车辆?) then (是)
      :生成 AI 推荐方案;
      :标记车辆已被本轮使用;
    else (否)
      :跳过该需求;
    endif
  repeat while (还有需求?) is (是)
else (人工调度)
  :管理员选择需求;
  :选择空闲车辆和司机;
  if (车辆座位数足够且绑定合法?) then (是)
    :生成人工调度方案;
  else (否)
    :提示无法调度;
    stop
  endif
endif

if (管理员确认方案?) then (是)
  :需求状态=已调度;
  :车辆状态=运行中;
  :司机绑定车辆;
  :生成车辆位置记录;
  :进入实时监控;
else (否)
  :方案保持待确认;
endif
stop
@enduml
